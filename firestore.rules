rules_version = '2';

// IMPORTANTE: este ficheiro é usado aqui só para o emulador local de
// desenvolvimento. As regras REAIS de produção vivem em
// projectogestaodefilas/firestore.rules (repo da app cliente) — as duas
// têm de se manter idênticas, porque partilham o mesmo projecto Firebase
// (filacerta-d74f0). Nunca fazer `firebase deploy --only firestore:rules`
// a partir deste repositório sem primeiro confirmar que este ficheiro e o
// da app cliente estão sincronizados.
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados pessoais da conta do cliente (agendamentos, histórico,
    // preferências) — regra original da app cliente, inalterada.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Perfil de um membro de equipa (agente/gestor) — só o próprio lê o
    // seu perfil; a atribuição de função/instituição é feita manualmente
    // (consola/seed), nunca pelo próprio utilizador.
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Fila ao vivo de uma instituição: qualquer utilizador autenticado
    // (incluindo sessão anónima do ecrã público) pode LER — não há dados
    // pessoais do cliente aqui, só código da senha/serviço/guichê.
    // Só um membro de equipa dessa instituição pode ESCREVER (chamar,
    // transferir, pausar balcão, etc.).
    match /institutions/{institutionId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.institutionId == institutionId;
    }

    // Cliente (app móvel, conta normal — nunca sessão anónima) pode
    // retirar a sua própria senha e desistir dela enquanto está em
    // espera. Não pode tocar em mais nenhum campo nem senha de outrem;
    // qualquer outra transição (chamar, transferir, concluir) continua
    // reservada à equipa pela regra acima.
    match /institutions/{institutionId}/branches/{branchId}/tickets/{ticketId} {
      allow create: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.counterId == null &&
        request.resource.data.transferredToCounterId == null;

      allow update: if request.auth != null &&
        resource.data.customerUid == request.auth.uid &&
        resource.data.status == 'waiting' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'no_show';
    }

    // Contador usado para gerar o código sequencial da senha do cliente
    // (ex.: B001, B002, ...) — só pode avançar de 1 em 1.
    match /institutions/{institutionId}/branches/{branchId}/meta/ticketSeq {
      allow write: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.resource.data.seq is int &&
        (
          (!exists(/databases/$(database)/documents/institutions/$(institutionId)/branches/$(branchId)/meta/ticketSeq) &&
            request.resource.data.seq == 1) ||
          (exists(/databases/$(database)/documents/institutions/$(institutionId)/branches/$(branchId)/meta/ticketSeq) &&
            request.resource.data.seq == resource.data.seq + 1)
        );
    }
  }
}
