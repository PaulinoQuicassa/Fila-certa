# Copie este ficheiro para "supabase/.env.secrets" (sem ".example") e
# preencha com os valores reais -- NUNCA cole estes valores no chat.
# "supabase/.env.secrets" está no .gitignore (nunca vai para o Git).
#
# Depois de preenchido, avise para eu correr:
#   supabase secrets set --env-file supabase/.env.secrets --project-ref qdfpqispcntitvczybfl
# (eu nunca abro/leio este ficheiro para o mostrar -- só o passo ao CLI.)

# Conta Twilio (console.twilio.com -> Account -> API keys & tokens)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SMS -- um dos dois (Messaging Service é o recomendado)
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=

# WhatsApp Business Platform (Twilio) -- formato "whatsapp:+1..."
TWILIO_WHATSAPP_FROM=
# Content SID de cada template aprovado (Twilio Console -> Content Template Builder)
TWILIO_WHATSAPP_TEMPLATE_QUEUE_CALLED=
TWILIO_WHATSAPP_TEMPLATE_QUEUE_NEAR_TURN=

# URL pública desta Edge Function depois de publicada -- normalmente
# https://qdfpqispcntitvczybfl.supabase.co/functions/v1/twilio-status-callback
# (não é secreta, mas fica aqui por conveniência)
TWILIO_STATUS_CALLBACK_URL=
