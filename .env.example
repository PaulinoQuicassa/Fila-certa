# Copiar para .env.local.

# Projecto Supabase real (qdfpqispcntitvczybfl) -- a "publishable key"
# não é secreta, ver docs/security-rls.md. Sem estas duas, src/supabase.ts
# lança logo no arranque (ver .github/workflows/ci.yml para onde ficam
# definidas em CI/build de produção).
VITE_SUPABASE_URL=https://qdfpqispcntitvczybfl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_HLelr-FOPvSL9a5w8_feUw_FfKIrOoQ

# Conta técnica da estação de auto-atendimento (src/pages/Estacao.tsx) --
# só precisa de existir no Supabase (Authentication → Add user), sem
# perfil de staff associado. SEM valor por omissão (ver
# docs/security-credentials.md) -- sem estas duas definidas, /estacao
# falha com uma mensagem clara em vez de usar uma password adivinhável.
# Nunca reutilizar a mesma password das contas de staff/teste.
VITE_STATION_EMAIL=estacao@filacerta.test
VITE_STATION_PASSWORD=

# /painel e /estacao já escolhem a instituição pelo URL
# (/painel/siac, /estacao/bfa, ...) -- ver src/lib/pilotInstitutions.ts
# para a lista das 6 instituições reais do piloto. Estas variáveis
# deixaram de ser necessárias.
